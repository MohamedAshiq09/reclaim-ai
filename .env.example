# ==============================================================================
# ReclaimAI Environment Configuration
# ==============================================================================

# Fetch.ai Agentverse API Key (Required for Agentverse mailbox & discovery)
AGENTVERSE_API_KEY=

# ASI:One API Key (OpenAI-compatible endpoint: https://api.asi1.ai/v1, model: asi1-mini)
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini

# Optional Web Search API Key (Tavily / Brave / SerpAPI for live contact lookup)
SEARCH_API_KEY=

# Email Dispatch Configuration (Resend API)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Demo Mode Settings
# When DEMO_MODE=1:
# 1. All outgoing emails are redirected to DEMO_RECIPIENT_OVERRIDE instead of real companies.
# 2. Escalation deadlines are accelerated to 2 minutes so judges see autonomous action live.
DEMO_MODE=1
DEMO_RECIPIENT_OVERRIDE=

# Native FET Payment Protocol Configuration
FET_USE_TESTNET=true
FET_PAYMENT_AMOUNT=0.001

# Timeouts (seconds) keeping the shared Bureau event loop responsive (<15s target).
# Each ASI:One call is capped and offloaded to a worker thread; on timeout the
# agents degrade to their deterministic offline paths instead of freezing.
LLM_TIMEOUT_S=15
DRAFT_TIMEOUT_S=15

# Agent Seeds (Distinct secret seed phrases for deterministic agent addresses)
CONCIERGE_SEED=reclaimai_concierge_seed_phrase_hackathon_2026_festive
RESEARCHER_SEED=reclaimai_researcher_seed_phrase_hackathon_2026_festive
DRAFTER_SEED=reclaimai_drafter_seed_phrase_hackathon_2026_festive
DISPATCHER_SEED=reclaimai_dispatcher_seed_phrase_hackathon_2026_festive
WATCHER_SEED=reclaimai_watcher_seed_phrase_hackathon_2026_festive

# Inter-agent Addresses (Auto-populated with deterministic addresses derived from above seeds)
CONCIERGE_ADDRESS=agent1q2a0f0a8zyw3229agt7saxtvenftxwe0gry6nv02dzd78rvye98tzty77e7
RESEARCHER_ADDRESS=agent1qgktn2gauj62w4uaynnapajvsexxjgxuq8ylj6ru2503p9hxt09h6tcgaum
DRAFTER_ADDRESS=agent1q00z4x9d574zttujnjwkj7zz7u0elv4jw4exrrefvqegjnz0dntu5cj5js0
DISPATCHER_ADDRESS=agent1qg9evq8equ7kkt2nw8fkg2wgujr6sy69ucpeflyr28539rnx8v7ng2wuu8l
